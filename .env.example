# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chess
POSTGRES_PORT=5432
DB_INTERNAL_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=3000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend
FRONTEND_PORT=80
VITE_API_URL=/app-api
VITE_SOCKET_URL=/api-url/ws
API_URL=http://<backend container name>:<backend port>
SOCKET_URL=http://<backend container name>:<backend port>/ws